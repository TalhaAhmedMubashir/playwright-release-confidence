{
  "name": "playwright-release-confidence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app:start": "node scripts/start-app.mjs",
    "app:stop": "docker compose down",
    "explore": "node explore/visitor.mjs",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "playwright test --project=setup --project=api --project=chromium --project=firefox --project=webkit --project=a11y",
    "test:pr": "playwright test --project=setup --project=api --project=chromium --grep \"@api|@smoke|@setup\"",
    "test:meta": "playwright test --project=meta",
    "gate": "node scripts/gate.ts test-results/results.json",
    "check:collected": "node scripts/check-collected.ts",
    "check:test-cases": "node scripts/check-test-cases.ts",
    "readme:numbers": "node scripts/readme-numbers.ts",
    "readme:check": "node scripts/readme-numbers.ts --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "zod": "^4.6.5"
  }
}
